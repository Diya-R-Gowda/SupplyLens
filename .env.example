# Copy this file to .env at the repo root (server/index.js loads it from
# ../.env relative to itself) and fill in real values. Never commit the
# real .env - it's already in .gitignore.

# --- Server ---

PORT=5000

# MongoDB Atlas connection string. If unset, the server runs in "demo mode"
# (no real database, canned in-memory data) - a legitimate fallback for
# trying the app without setting up a cluster, not an error state.
MONGO_URI=

# Secret used to sign/verify JWT access tokens. Use a long random string in
# any real deployment - never reuse the value from another project.
JWT_SECRET=

# Gemini API key (Google AI Studio) - powers enrichment, ESG/logistics
# estimates, RAG answers, and the Phase 8 persona agents. Without it, those
# features fail gracefully rather than crashing, but return no real output.
GEMINI_API_KEY=

# Currents API key (currentsapi.services) - powers the news/sentiment
# fetch. Without it, news fetches are skipped (logged, not thrown).
CURRENTS_API_KEY=

# Comma-separated list of allowed CORS origins, e.g.
# https://app.example.com,https://admin.example.com
# If unset, falls back to local-dev-only origins (Vite dev server on 5173,
# Docker-compose client on 8080) and logs a warning - set this explicitly
# in any real deployment.
CORS_ORIGIN=

# pino log level: trace|debug|info|warn|error|fatal. Defaults to "info" if unset.
LOG_LEVEL=

# --- Client (build-time, not runtime - see client/Dockerfile and vite.config.js) ---

# Where the built frontend sends API requests. Defaults to
# http://127.0.0.1:5000/api (this repo's local-dev value) if unset.
VITE_API_BASE_URL=
